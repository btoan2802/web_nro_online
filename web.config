<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <rule name="Login" stopProcessing="true">
          <match url="^Login$" />
          <action type="Rewrite" url="pages/dangnhap.php" />
        </rule>

        <rule name="Register" stopProcessing="true">
          <match url="^Register$" />
          <action type="Rewrite" url="pages/dangky.php" />
        </rule>

        <rule name="Logout" stopProcessing="true">
          <match url="^Logout$" />
          <action type="Rewrite" url="pages/dangxuat.php" />
        </rule>

        <rule name="ThongTin" stopProcessing="true">
          <match url="^ThongTin$" />
          <action type="Rewrite" url="thong_tin_game.php" />
        </rule>

        <rule name="SuKienShare" stopProcessing="true">
          <match url="^SuKienShare$" />
          <action type="Rewrite" url="su_kien_share.php" />
        </rule>

        <rule name="BXH" stopProcessing="true">
          <match url="^BXH$" />
          <action type="Rewrite" url="bxh.php" />
        </rule>

        <rule name="NapTien" stopProcessing="true">
          <match url="^NapTien$" />
          <action type="Rewrite" url="NapTien.php" />
        </rule>

        <rule name="napATM" stopProcessing="true">
          <match url="^napATM$" />
          <action type="Rewrite" url="napatm.php" />
        </rule>

        <rule name="napCARD" stopProcessing="true">
          <match url="^napCARD$" />
          <action type="Rewrite" url="napthe.php" />
        </rule>

        <rule name="KichHoat" stopProcessing="true">
          <match url="^KichHoat$" />
          <action type="Rewrite" url="pages/kichhoat.php" />
        </rule>

        <rule name="Profile" stopProcessing="true">
          <match url="^Profile$" />
          <action type="Rewrite" url="pages/profile.php" />
        </rule>

        <rule name="Giftcode" stopProcessing="true">
          <match url="^Giftcode$" />
          <action type="Rewrite" url="danhsach_gift.php" />
        </rule>

        <rule name="NhanGift" stopProcessing="true">
          <match url="^NhanGift$" />
          <action type="Rewrite" url="pages/doigift.php" />
        </rule>

        <rule name="DoiMatKhau" stopProcessing="true">
          <match url="^DoiMatKhau$" />
          <action type="Rewrite" url="pages/doimatkhau.php" />
        </rule>

        <rule name="DoiThoiVang" stopProcessing="true">
          <match url="^DoiThoiVang$" />
          <action type="Rewrite" url="doi_thoi_vang.php" />
        </rule>

        <rule name="QuyDoi" stopProcessing="true">
          <match url="^QuyDoi$" />
          <action type="Rewrite" url="goldbar_callback.php" />
        </rule>

        <rule name="Captcha" stopProcessing="true">
          <match url="^Captcha$" />
          <action type="Rewrite" url="core/captcha.php" />
        </rule>

        <rule name="TrangChu" stopProcessing="true">
          <match url="^trang-chu$" />
          <action type="Rewrite" url="index.php" />
        </rule>

        <rule name="AdminSetting" stopProcessing="true">
          <match url="^ADMIN/SETTING$" />
          <action type="Rewrite" url="Users/Admin/account/Setting.php" />
        </rule>

        <rule name="AdminAccount" stopProcessing="true">
          <match url="^ADMIN/ACCOUNT$" />
          <action type="Rewrite" url="Users/Admin/account/account.php" />
        </rule>

        <rule name="AdminAddVnd" stopProcessing="true">
          <match url="^ADMIN/ADD_VND$" />
          <action type="Rewrite" url="Users/Admin/account/account_vnd.php" />
        </rule>

        <rule name="AdminItems" stopProcessing="true">
          <match url="^ADMIN/ITEMS$" />
          <action type="Rewrite" url="Users/Admin/items/items.php" />
        </rule>

        <rule name="AdminAddItems" stopProcessing="true">
          <match url="^ADMIN/ADD-ITEMS$" />
          <action type="Rewrite" url="Users/Admin/items/add.php" />
        </rule>

        <rule name="AdminEditAccount" stopProcessing="true">
          <match url="^ADMIN/EDIT/([0-9]+)$" />
          <action type="Rewrite" url="Users/Admin/account/edit.php?id={R:1}" />
        </rule>

        <rule name="AdminDeleteAccount" stopProcessing="true">
          <match url="^ADMIN/DELETE/([0-9]+)$" />
          <action type="Rewrite" url="Users/Admin/account/delete.php?id={R:1}" />
        </rule>
        
      </rules>
    </rewrite>
  </system.webServer>
</configuration>